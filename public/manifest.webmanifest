{
  "id": "/",
  "name": "Kabmo",
  "short_name": "Kabmo",
  "description": "Browser console and diagnostic workbench for AI coding agents.",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0B5D3B",
  "theme_color": "#0B5D3B",
  "start_url": "/",
  "scope": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt", ".text", ".log", ".env"],
        "text/markdown": [".md", ".markdown", ".mdx"],
        "text/csv": [".csv", ".tsv"],
        "application/json": [".json", ".jsonc"],
        "application/x-yaml": [".yaml", ".yml"],
        "application/toml": [".toml"],
        "application/xml": [".xml"],
        "text/html": [".html", ".htm"],
        "text/css": [".css", ".scss", ".less"],
        "text/javascript": [".js", ".mjs", ".cjs", ".jsx"],
        "text/x-typescript": [".ts", ".tsx", ".mts", ".cts"],
        "text/x-python": [".py"],
        "text/x-go": [".go"],
        "text/x-rust": [".rs"],
        "text/x-java": [".java", ".kt", ".kts"],
        "text/x-ruby": [".rb"],
        "text/x-php": [".php"],
        "text/x-c": [".c", ".h"],
        "text/x-cpp": [".cpp", ".cc", ".hpp"],
        "text/x-csharp": [".cs"],
        "text/x-swift": [".swift"],
        "text/x-sh": [".sh", ".bash", ".zsh"],
        "text/x-sql": [".sql"],
        "text/x-diff": [".diff", ".patch"],
        "image/svg+xml": [".svg"],
        "image/png": [".png", ".apng"],
        "image/jpeg": [".jpg", ".jpeg", ".jfif"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/avif": [".avif"],
        "image/bmp": [".bmp"],
        "image/tiff": [".tif", ".tiff"],
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx", ".xlsm"]
      },
      "icons": [
        {
          "src": "/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
