{
  // The published packages are shipped as `.ts` SOURCE, so their type surface is
  // whatever those files say — including any ambient global they name. This
  // project typechecks them the way an outside consumer resolves them: through
  // `package.json` `exports` (the bun workspace symlink, no `paths`), and with
  // NO ambient types at all.
  //
  // That is the one thing the root program cannot check. `tsconfig.json` includes
  // `packages` AND has `bun-types`/`@types/node` installed, so `NodeJS.Signals`
  // in `signals.ts` typechecked here while failing for every consumer without
  // `@types/node` — `TS2503`, and `skipLibCheck` does not hide it because the
  // shipped file is `.ts`, not `.d.ts` (measured: a plugin-half consumer with
  // `"types": []` and `skipLibCheck: true`).
  //
  // `types: []` also rules out a Bun global (`Bun.spawn`, `Bun.env`) reaching the
  // browser half of a plugin, whose bundler has no such global either.
  //
  // `packages/kabmo-omp/src/paths` is deliberately absent: it is server-only and
  // imports `fs`/`os`/`path`, so it has no browser-safe surface to check here.
  // The root program covers it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "packages/kabmo-sdk/src",
    "packages/kabmo-ui/src",
    "packages/kabmo-chat/src/contracts",
    "packages/kabmo-settings/src/contracts",
    "packages/kabmo-auth/src",
    "packages/kabmo-chat/src/tool",
    "packages/kabmo-chat/src/notices",
    "packages/kabmo-model-contracts/src",
    "packages/kabmo-format/src",
    "packages/kabmo-fs/src/media",
    "packages/kabmo-omp/src/proc",
    "packages/kabmo-guards/src",
    "packages/kabmo-bytes/src",
    "packages/kabmo-platform/src",
    "packages/kabmo-harness/src/catalog",
    "packages/kabmo-harness/src/contract",
    "packages/kabmo-harness/src/registry",
    "packages/kabmo-harness/src/accounts",
    "packages/kabmo-harness/src/session-modes",
    "packages/kabmo-harness/src/transcript",
    "packages/kabmo-harness/src/provider-slug",
    "packages/kabmo-harness/src/provider",
    "packages/kabmo-harness/src/config",
    "packages/kabmo-harness/src/enabled",
    "packages/kabmo-harness/src/updates",
    "packages/kabmo-harness/src/config-fields",
    "packages/kabmo-harness/src/mcp-facts",
    "packages/kabmo-harness/src/rewind",
    "packages/kabmo-omp/src/mode",
    "packages/kabmo-omp/src/schema",
    "packages/kabmo-omp/src/session-core",
    "packages/kabmo-omp/src/session-parse",
    "packages/kabmo-omp/src/mapper",
    "packages/kabmo-omp/src/messages-map",
    "packages/kabmo-omp/src/contracts",
    "packages/kabmo-omp/src/operator-title",
    "packages/kabmo-omp-access-mode/src"
  ],
  // Tests may name `bun:test` and the host's own globals; they are not shipped.
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
