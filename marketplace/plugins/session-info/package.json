{
  "name": "session-info",
  "version": "0.1.0",
  "private": true,
  "description": "Shows the active workspace and keeps a note per session.",
  "type": "module",
  "kabmo": {
    "id": "session-info",
    "name": "Session Info",
    "version": "0.1.0",
    "description": "Shows the active workspace and keeps a note per session.",
    "app": "dist/app.js",
    "server": "dist/server.js",
    "icon": "icon.svg",
    "author": { "name": "Kabmo Labs", "url": "https://github.com/kabmo-labs" },
    "slots": ["rightPanel", "panel", "headerPanel"],
    "settings": {
      "notePrefix": {
        "type": "string",
        "label": "Note prefix",
        "description": "Prepended to every note saved by the server half.",
        "default": ""
      }
    },
    "css": "dist/app.css"
  },
  "peerDependencies": {
    "@kabmo-labs/kabmo-sdk": "*",
    "@kabmo-labs/kabmo-ui": "*",
    "preact": "^10.29.8"
  },
  "peerDependenciesMeta": {
    "@kabmo-labs/kabmo-sdk": {
      "optional": true
    },
    "@kabmo-labs/kabmo-ui": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  }
}
