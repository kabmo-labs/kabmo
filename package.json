{
  "name": "@kabmo-labs/kabmo",
  "version": "0.14.1",
  "description": "Web console and diagnostic workbench for AI coding agents — Elysia + Preact on Bun.",
  "license": "MIT",
  "author": "Wijanarko Putra Rajeb <wijanarko.rajeb@gmail.com>",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kabmo": "./src/cli/kabmo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabmo-labs/kabmo.git"
  },
  "homepage": "https://github.com/kabmo-labs/kabmo#readme",
  "bugs": {
    "url": "https://github.com/kabmo-labs/kabmo/issues"
  },
  "keywords": [
    "kabmo",
    "coding-agent",
    "agent",
    "console",
    "elysia",
    "preact",
    "bun"
  ],
  "files": [
    "src",
    "extensions",
    "index.html",
    "bunfig.toml",
    "public",
    "tsconfig.json",
    "marketplace",
    "dist/client"
  ],
  "scripts": {
    "dev": "bun run --hot src/server/index.ts --kabmo-server",
    "dev:lan": "HOST=0.0.0.0 bun run --hot src/server/index.ts --kabmo-server",
    "build": "bun run scripts/build-client.ts",
    "editor:themes": "bun run scripts/editor-themes.mjs",
    "editor:themes:check": "bun run scripts/editor-themes.mjs --check",
    "omp:schema": "bun run scripts/omp-schema.mjs",
    "omp:schema:check": "bun run scripts/omp-schema.mjs --check",
    "start": "NODE_ENV=production bun run src/server/index.ts --kabmo-server",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:fast": "bun check --no-script",
    "test": "bun test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "readme:media": "bun run scripts/readme-media.ts",
    "shell:wordmark": "bun run scripts/shell-wordmark.mjs",
    "shell:docs": "bun run scripts/shell-document-types.mjs --write",
    "shell:docs:check": "bun run scripts/shell-document-types.mjs --check",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e",
    "publish:plugins": "bash .github/scripts/publish-plugin-packages.sh packages/kabmo-sdk packages/kabmo-ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/fira-code": "^5.3.0",
    "@kabmo-labs/kabmo-sdk": "workspace:*",
    "@kabmo-labs/kabmo-ui": "workspace:*",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "elysia": "^1.4.30",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.18.7",
    "lucide-preact": "^1.47.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.11",
    "marked-linkify-it": "^4.0.2",
    "mermaid": "^12.0.0",
    "postcss": "^8.5.16",
    "preact": "^10.29.8",
    "read-excel-file": "^9.3.12",
    "remend": "^1.3.1",
    "ripgrep": "^0.3.1",
    "shiki": "^4.4.3",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.1.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "1.4.4",
    "@types/node": "^22.14.0",
    "bun-types": "1.4.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^20.14.5",
    "semantic-release": "^25.0.9",
    "typescript": "~5.8.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
