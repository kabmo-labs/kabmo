# PORT: Port the web server binds to (default 3000). The CLI takes the same value from
# `--port`, or from KABMO_PORT when no flag is passed.
PORT="3000"

# HOST: Bind address (default localhost). `kabmo serve` has its own default of 127.0.0.1;
# use --lan, or this variable, to accept connections from the network.
HOST="localhost"

# MOCK: When set to 'true', all features use mock data (simulated demo chats, token telemetry, settings presets).
# When set to 'false' (or left unset), the application operates exclusively on real data (real SQLite database, real token counters, real workspace files).
MOCK="false"

# SYNC_WORKSPACE: Seed the workspace list from the omp projects discovered under
# ~/.omp/agent — but ONLY while that list is still empty. It is a one-time bootstrap, not a
# background indexer: a list you have curated (or emptied on purpose) is never appended to,
# because a session's cwd is whatever directory omp was spawned in, scratch directories included.
# Set to false to skip the bootstrap entirely.
SYNC_WORKSPACE=true

# KABMO_UI_PASSWORD: Require a password for the browser UI. Unset (the default) means no
# authentication. The value is hashed in memory for the process that reads it and then ERASED from
# the environment, so child processes (the terminal PTY, the omp child, git) never see it. Nothing
# is written to disk that could turn authentication on by itself.
#
# Pair it with TLS when the server is reachable by anyone else: without encryption the password and
# the session cookie cross the network in cleartext. Either serve over HTTPS (`kabmo serve
# --tls`) or reach the instance through an SSH port-forward, a VPN, or a tunnel
# (`cloudflared tunnel --url http://127.0.0.1:3000`).
# KABMO_UI_PASSWORD="change-me"

# KABMO_OMP_BIN: Explicit path to the `omp` binary. Without it the server looks for `omp`
# on PATH and refuses to start when there is none — MOCK=true is the only mode that runs without one.
# KABMO_OMP_BIN="/usr/local/bin/omp"

# The pre-rename OMPCHAMBER_* spellings of the variables above are still read as fallbacks, so an
# existing shell profile or unit file keeps working; the KABMO_* names win when both are set.
