<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!--
    The app's own identity, and long-path support.

    DPI awareness is NOT declared here. The project also enables WinForms (for
    `NotifyIcon`), and its analyzer rejects a DPI block in the manifest —
    `WFAC010`, measured on the Release publish — because WinForms owns that
    decision through a project property. `ApplicationHighDpiMode` in the csproj
    states PerMonitorV2, and WPF on .NET 8 defaults to it anyway, so a window on
    a scaled display is still measured rather than bitmap-stretched.
  -->
  <!-- The app identity Windows reports: one name, the same one the exe carries. -->
  <assemblyIdentity version="0.1.0.0" name="Kabmo" />
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
