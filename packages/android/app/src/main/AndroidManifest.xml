<?xml version="1.0" encoding="utf-8"?>
<!--
  The Kabmo Android shell.

  Three manifest decisions are load-bearing and each is explained where it sits:
  cleartext traffic (the whole point of a self-hosted console on a LAN), the
  launcher shortcut that opens the server settings without touching the webview,
  and a single non-exported Activity so no other app can drive this shell.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Agent notifications (finished / waiting / failed). On API 33+ this is a
      runtime permission the shell asks for only when a notification preference
      is switched on; older releases grant it at install. The WebView cannot ask
      for it, which is why the console asks the shell.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The background watcher (`NotificationWatchService`). A backgrounded WebView
      is frozen, so the page cannot post a banner for a run that ends while the
      app is away; the shell holds its own connection to the server's
      notification stream instead. Android only allows that as a foreground
      service, which is why the app shows an ongoing row while it is away.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      `specialUse`, not `dataSync`: a dataSync foreground service is cut off
      after 6 hours per day on Android 15, and this one has to stay up for as
      long as the operator's notification switches are on. The subtype below is
      the declaration the platform asks for in exchange.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      The in-app APK update (`ApkInstaller`). Android requires the permission to
      CREATE an install session at all; the user still grants the per-app
      "install unknown apps" toggle once, and the system still shows its own
      confirmation dialog for every install. This is what removes the file
      manager from the flow, not the consent.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kabmo">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Long-press the launcher icon → "Server settings". This is the
              always-available way back to the setup screen: the webview fills
              the screen, so an in-page control can be covered by Kabmo's own
              chrome, and a user who saved a wrong URL would otherwise have no
              way out.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
              The documents Kabmo can render, so another app can hand one over:
              "Open with → Kabmo" from a file manager (`VIEW`) and "Share to
              Kabmo" (`SEND`). GENERATED from `release/document-types.mjs` by
              `scripts/shell-document-types.mjs`; never hand-edited.

              The bytes travel through the PAGE, not the server: a phone's file
              exists only on the phone, so a console on another machine could
              never read it. The tab that opens is read-only, and says so.
            -->
<!-- BEGIN GENERATED document-types: run `bun run shell:docs` -->
    <intent-filter>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.DEFAULT" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:mimeType="application/pdf" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
      <data android:mimeType="application/vnd.ms-excel" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
      <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
      <data android:mimeType="text/markdown" />
      <data android:mimeType="text/csv" />
      <data android:mimeType="text/tab-separated-values" />
      <data android:mimeType="image/svg+xml" />
      <data android:mimeType="image/png" />
      <data android:mimeType="text/plain" />
      <data android:mimeType="application/json" />
    </intent-filter>
    <intent-filter>
      <action android:name="android.intent.action.SEND" />
      <category android:name="android.intent.category.DEFAULT" />
      <data android:mimeType="application/pdf" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
      <data android:mimeType="application/vnd.ms-excel" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
      <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
      <data android:mimeType="text/markdown" />
      <data android:mimeType="text/csv" />
      <data android:mimeType="text/tab-separated-values" />
      <data android:mimeType="image/svg+xml" />
      <data android:mimeType="image/png" />
      <data android:mimeType="text/plain" />
      <data android:mimeType="application/json" />
    </intent-filter>
<!-- END GENERATED document-types -->
        </activity>

        <!--
          The notification watcher. The type is declared here because Android 14+
          refuses a foreground service whose type is not in the manifest, and
          `specialUse` (rather than `dataSync`) is what a connection that must
          outlive a working day needs — see the subtype property below. Not
          exported: only this app starts it.
        -->
        <service
            android:name=".NotificationWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps agent run and awaiting-input notifications arriving while the console is closed" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Kabmo" />

        <!--
          The installer's answer. Declared here rather than registered in code
          because an install can outlive the Activity: Android kills the process
          it is replacing, so a runtime-registered receiver would be gone exactly
          when the terminal status arrives. Not exported — only the system's
          installer sends this action.
        -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.kabmo.shell.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
