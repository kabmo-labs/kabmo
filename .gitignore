node_modules/
build/
dist/
coverage/

# A plugin's own lockfile is written by the `bun install` Kabmo runs
# before building it (see lib/panels/build.server.ts), not by a plugin
# author — the shipped plugins commit none.
marketplace/plugins/*/bun.lock
.DS_Store
*.log
.env*
!.env.example
workspace.db
*.db
*.db-shm
*.db-wal
*.sqlite
.kabmo/
.ompchamber/
.playwright-mcp

# Scratch git repositories written by the fs/git action tests.
# `tmp-test-git-*` covers every suite's own root: the merge, branch and stash
# suites each own a directory so a failure in one cannot leave a repository the
# next one reads.
tmp-test-git-*/

# Playwright E2E artifacts (traces, screenshots, HTML report).
test-results/
playwright-report/

# Scratch reproduction harnesses (not committed).
tmp-repro/

# SwiftPM writes a dot-directory BESIDE the sources, which `build/` above does
# not cover — measured: `packages/macos/.build` alone is 3,745 untracked entries
# after one `swift build`, and a `git add packages/macos` would commit all of it.
packages/macos/.build/
