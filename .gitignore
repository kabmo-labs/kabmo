node_modules/
build/
dist/
coverage/

# Release artifacts produced by the shell packaging scripts
# (`packages/*/scripts/package-*.sh`) when a developer runs them locally. The
# pipeline writes them inside a CI workspace, but a local run must not leave
# binaries staged for commit.
artifacts/

# A plugin's own lockfile is written by the `bun install` Kabmo runs
# before building it (see lib/panels/build.server.ts), not by a plugin
# author — the shipped plugins commit none.
marketplace/plugins/*/bun.lock
.DS_Store
*.log
.env*
!.env.example
workspace.db
*.db
*.db-shm
*.db-wal
*.sqlite
.kabmo/
.ompchamber/
.playwright-mcp

# Scratch git repositories written by the fs/git action tests.
# `tmp-test-git-*` covers every suite's own root: the merge, branch and stash
# suites each own a directory so a failure in one cannot leave a repository the
# next one reads.
tmp-test-git-*/

# Playwright E2E artifacts (traces, screenshots, HTML report).
test-results/
playwright-report/

# Scratch reproduction harnesses (not committed).
tmp-repro/

# The native shells' build output. `build/` above covers the assembled bundles
# (`packages/macos/build/Kabmo.app`), but SwiftPM and Cargo write a dot-directory
# BESIDE the sources, which no pattern covers — measured: `packages/macos/.build`
# alone is 3,745 untracked entries after one `swift build`.
packages/macos/.build/
packages/linux/.build/
packages/linux/target/
# .NET writes `bin/` and `obj/` inside the project, not at the shell's root.
packages/windows/**/bin/
packages/windows/**/obj/
